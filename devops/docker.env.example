# Copy to devops/docker.env (gitignored) and fill in real values before
# running `make up`. These are the env vars injected into every container —
# separate from the repo-root .env, which is only read by processes run
# directly on the host (outside Docker).

DJANGO_SETTINGS_MODULE=main.settings.base
DATABASE_URL=postgres://postgres:postgres@db:5432/quiz_management_db
DB_CONN_MAX_AGE=60
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=replace-me
SECRET_KEY=replace-me
ENVIRONMENT=local
POSTGRES_DB=quiz_management_db
POSTGRES_USER=replace-me
POSTGRES_PASSWORD=replace-me
